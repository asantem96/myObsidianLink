formulas:
  Untitled: ""
views:
  - type: cards
    name: Gallery View
    filters:
      and:
        - file.inFolder("main/home/media/anime")
    order:
      - title
      - formula.Untitled
      - dateStarted
      - dateFinished
    image: note.image
    cardSize: 150
    imageFit: contain
    imageAspectRatio: 1.4
